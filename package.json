{
  "name": "@agilehub/latex-formula",
  "version": "1.0.0",
  "description": "Vue 3 LaTeX editor component with MathJax rendering, symbol library, and export to LaTeX/MathML/base64 PNG",
  "repository": {
    "type": "git",
    "url": "https://github.com/lytdev/latex-formula.git"
  },
  "license": "Apache 2.0",
  "author": "lytdev <lytdev@outlook.com>",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/latex-formula.cjs",
  "module": "./dist/latex-formula.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/latex-formula.mjs",
      "require": "./dist/latex-formula.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "test:package": "node --test tests/package-smoke.mjs tests/symbols-smoke.mjs",
    "test:editor": "node --test tests/editor-smoke.mjs",
    "test:png": "node --test tests/png-export.mjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.23.1",
    "mathjax-full": "^3.2.2",
    "mathlive": "^0.111.1",
    "tdesign-icons-vue-next": "^0.4.7",
    "tdesign-vue-next": "^1.20.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "latex",
    "mathjax",
    "vue",
    "editor",
    "math",
    "formula"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
