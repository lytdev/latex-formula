{
  "name": "agile-latex",
  "version": "0.1.0",
  "description": "Vue 3 LaTeX editor component with MathJax rendering, symbol library, and export to LaTeX/MathML/base64 PNG",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/agile-latex.cjs",
  "module": "./dist/agile-latex.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agile-latex.mjs",
      "require": "./dist/agile-latex.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "tdesign-vue-next": "^1.9.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "tdesign-vue-next": "^1.9.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": ["latex", "mathjax", "vue", "editor", "math", "formula"],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
